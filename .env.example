# Edge function secrets.
#
# Production:  supabase secrets set OPENAI_API_KEY=sk-...
# Local:       copy this file to supabase/.env and run
#              supabase functions serve --env-file ./supabase/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the platform - do not set them here in production.

# Required
OPENAI_API_KEY=sk-your-openai-key

# Optional
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=180000

# Lock CORS to your deployed frontends once they are live ("*" during development)
ALLOWED_ORIGIN=*
